<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudnote.mapper.NoteBookTypeMapper">

    <select id="findByCode" parameterType="string" resultType="com.cloudnote.entity.NoteBookType">
        select * from cn_notebook_type where cn_notebook_type_code = #{code}
    </select>
</mapper>
